# ---------------------------------------------------------------------------
# DrawCoach AI environment
# Copy to `.env` and fill in. `.env` is git-ignored — never commit real keys.
# ---------------------------------------------------------------------------

# Server-side only. Used by the /api/critique Expo Router route to call Claude.
# This variable has NO EXPO_PUBLIC_ prefix, so it is never bundled into the app.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the Claude model used for visual critique.
# Defaults to claude-opus-5 (best judgement). For a cheaper, still vision-capable
# option at higher volume, set claude-sonnet-5. See src/services/critiquePrompt.ts.
# CRITIQUE_MODEL=claude-opus-5

# Optional: base URL of the deployed API server, used by NATIVE builds to reach
# the /api/critique route in production. Leave unset in web/dev — the app then
# targets same-origin (web) or the Metro dev host (native dev) automatically.
# Must be EXPO_PUBLIC_ so the client can read it.
# EXPO_PUBLIC_API_URL=https://your-drawcoach-server.example.com
