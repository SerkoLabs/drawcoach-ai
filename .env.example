# Public mobile configuration only. Never put OpenAI or Supabase privileged keys here.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only examples (DO NOT prefix with EXPO_PUBLIC_ and do not commit real values):
# OPENAI_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
